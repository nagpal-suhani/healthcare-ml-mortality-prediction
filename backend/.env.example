# Comma-separated list of origins allowed to call this API (CORS).
# Include your frontend's dev server URL(s). Use "*" to allow any
# origin (fine for local development, NOT recommended in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host/port uvicorn binds to when started via `python -m app.main`
# directly. Not needed if you launch with `uvicorn app.main:app` and
# pass --host/--port on the command line instead.
HOST=127.0.0.1
PORT=8000
